# 웹 환경변수 — 값은 Vercel 프로젝트 설정에 등록한다 (이 파일에 실값 금지)
#
# 민감도 정책 (근거·함정은 PRD 14 §8 + "운영 함정"):
#   NEXT_PUBLIC_*  = 브라우저 번들에 박히는 공개값 → Vercel Non-sensitive
#   SENTRY_AUTH_TOKEN = 유일한 진짜 시크릿 → Vercel **Sensitive + Production 전용**
#   시크릿 입력은 대시보드나 별도 터미널에서 (--value는 히스토리에 평문으로 남는다)

# GA4 측정 ID. 없으면 GA 스크립트를 넣지 않는다 (layout.tsx)
NEXT_PUBLIC_GA_ID=

# Sentry DSN. 없으면 오류 수집이 통째로 꺼진다 (instrumentation*.ts)
# 공개값이지만 Production 전용으로 둔다 — Preview에 넣으면 프리뷰 오류가 프로덕션 이슈에 섞인다
NEXT_PUBLIC_SENTRY_DSN=

# 아래 3개는 빌드 시 소스맵 업로드용 (없으면 업로드만 건너뛰고 빌드는 통과).
# 업로드는 Vercel 빌드에서만 — 로컬은 @sentry/cli postinstall이 차단돼 바이너리가 없다
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
